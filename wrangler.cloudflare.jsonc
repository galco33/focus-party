{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "focus-party-pomodoro-g97",
  "main": "dist/server/index.js",
  "base_dir": "dist/server",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-party-db",
      "database_id": "80374466-fbeb-40f3-acba-5b47b92aa034"
    }
  ],
  "observability": {
    "enabled": true
  }
}
