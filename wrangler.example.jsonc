{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "VOTRE_NOM_DE_WORKER",
  "main": "dist/server/index.js",
  "base_dir": "dist/server",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-party-db",
      "database_id": "VOTRE_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ],
  "vars": {
    "TWITCH_CLIENT_ID": "VOTRE_TWITCH_CLIENT_ID"
  },
  "secrets": {
    "required": [
      "TWITCH_CLIENT_SECRET",
      "TWITCH_EVENTSUB_SECRET",
      "TWITCH_TOKEN_ENCRYPTION_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
